# Copy to .env. npm run dev loads it. Development defaults bind only to loopback.
NLI_PLANNER=demo
# For actual local LLM interpretation, set NLI_PLANNER=ollama and pull this model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional: set a stable random secret with at least 32 characters; dev generates one otherwise.
# NLI_SESSION_SECRET=
# NLI_ADAPTER_SECRET=
