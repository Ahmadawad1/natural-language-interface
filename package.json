{
  "name": "natural-language-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build --workspace @nli/protocol && npm run build --workspace @nli/backend && npm run build --workspace @nli/react && npm run build --workspace @nli/runtime && npm run build --workspace @nli/demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "verify:packages": "tsx scripts/verify-packages.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
